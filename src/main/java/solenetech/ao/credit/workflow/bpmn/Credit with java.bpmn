        <di:waypoint x="500" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToApprovedPath_di" bpmnElement="Flow_ToApprovedPath">
        <di:waypoint x="550" y="70" />
