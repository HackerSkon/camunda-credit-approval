  <bpmn:process id="Process_CreditApproval" name="Aprovação de Crédito" processType="None" isClosed="false" isExecutable="true">
    <bpmn:sequenceFlow id="Flow_0u75ne2" name="approved" sourceRef="Gateway_IsApproved" targetRef="Gateway_0gxtgxd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decision = "approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_IsApproved" name="Aprovado?" default="Flow_ToRejectedEnd">
      <bpmn:incoming>Flow_064flw4</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRejectedEnd</bpmn:outgoing>
      <bpmn:outgoing>Flow_0u75ne2</bpmn:outgoing>
      <bpmn:outgoing>Flow_1bka7rq</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Activity_EvaluateApproval" name="Avaliar Aprovação" implementation="##unspecified">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="decision-1puhkc4" resultVariable="decision" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1v2g8x3</bpmn:incoming>
      <bpmn:outgoing>Flow_0p3n4f5</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="Activity_CalculateScore" name="Calcular Score" implementation="##WebService">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="calculate-score" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0y5b9z1</bpmn:incoming>
      <bpmn:outgoing>Flow_1v2g8x3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_1mzgp8c" name="enviar email" zeebe:modelerTemplate="io.camunda.connectors.SendGrid.v2" zeebe:modelerTemplateVersion="5" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:sendgrid:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="{{apy.key}}" target="apiKey" />
          <zeebe:input source="Rudi" target="from.name" />
          <zeebe:input source="cristonicolau2@gmail.com" target="from.email" />
          <zeebe:input source="Rudi" target="to.name" />
          <zeebe:input source="cristonicolau2@gmail.com" target="to.email" />
          <zeebe:input source="mail" target="unMappedFieldNotUseInModel.mailType" />
          <zeebe:input source="Piada do dia" target="content.subject" />
          <zeebe:input source="text/plain" target="content.type" />
          <zeebe:input source="A sua solicitação foi aprovada" target="content.value" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="5" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.SendGrid.v2" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0rkwbyt</bpmn:incoming>
      <bpmn:outgoing>Flow_0dzyqwi</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_SendResult" name="Enviar Resultado" implementation="##WebService">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-result" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0p3n4f5</bpmn:incoming>
      <bpmn:outgoing>Flow_064flw4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_Approved" name="Fim (Aprovado)">
      <bpmn:incoming>Flow_0dzyqwi</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_Rejected" name="Fim (Rejeitado)">
      <bpmn:incoming>Flow_1trc3n8</bpmn:incoming>
