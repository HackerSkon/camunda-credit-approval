        <dc:Bounds height="45" width="125" x="177" y="297" />
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="DMNEdge_15d44f1" dmnElementRef="InformationRequirement_0a5rfou">
        <di:waypoint x="240" y="297" />
